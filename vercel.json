{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/", "destination": "/login.html", "permanent": false },
    { "source": "/studio", "destination": "/index.html", "permanent": false },
    { "source": "/login", "destination": "/login.html", "permanent": false },
    { "source": "/logout", "destination": "/logout.html", "permanent": false }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  }
}
